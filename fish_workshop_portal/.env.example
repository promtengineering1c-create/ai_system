APP_ENV=development
DJANGO__DEBUG=True
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO__SECRET_KEY=change-me-to-a-secure-random-secret-key
DJANGO__ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO__STORAGE_CACHE_DIR=/app/cache

# ADR-011: DB_HOST/DB_NAME/DB_USER/DB_PASSWORD только в базовом .env (без POSTGRES_*); пароль строго [A-Za-z0-9]
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fish_workshop_db
DB_USER=postgres
DB_PASSWORD=changeMeAlnumPassword123
DB_CONN_MAX_AGE=60

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

SECURITY_EXCHANGE_BEARER_TOKEN=change-me-to-exchange-token
SECURITY_RATE_LIMIT_REQUESTS=10
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60

EXCHANGE_DIR_PATH=/exchange
EXCHANGE_LOCAL_NODE_ID=WEB
EXCHANGE_REMOTE_NODE_ID=1C

CAPTCHA_PROVIDER=stub
CAPTCHA_CLIENT_KEY=
CAPTCHA_SERVER_KEY=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=False
SMTP_FROM_EMAIL=no-reply@fish-workshop.local